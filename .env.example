# ============================================================
# AST — Environment Reference
# ============================================================

NODE_ENV=development

# Cloudflare Turnstile (contact form bot verification). Both are optional:
# leaving them unset renders no widget and skips verification, so the form
# keeps working before Cloudflare is configured.
#
# VITE_TURNSTILE_SITE_KEY is public and safe to bundle into the client.
# TURNSTILE_SECRET_KEY is private — set it only in Vercel's project
# environment variables, never commit a real value here.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
