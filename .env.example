# ATS portfolio environment reference.
# The frontend is static-hosting friendly: no API, database, or local secrets
# are required for the visual portfolio.

# Used for metadata and canonical links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional hosted form endpoint (Formspree, Basin, FormSubmit, etc.).
# Configure this in the deployment environment before accepting enquiries.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
