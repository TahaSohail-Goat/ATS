# ============================================================
# ATS — Root Environment Reference
# Copy relevant values into apps/web/.env and apps/api/.env
# NEVER commit real secrets. This file documents shape only.
# ============================================================

# ---- Shared ----
NODE_ENV=development                 # development | test | staging | production

# ---- apps/api ----
PORT=4000
DATABASE_URL=postgresql://ats:ats@localhost:5432/ats_dev
JWT_SECRET=replace-with-a-long-random-string
SESSION_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info                       # fatal|error|warn|info|debug|trace

# ---- apps/web ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
